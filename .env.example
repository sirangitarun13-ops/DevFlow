# Development-only configuration template. Do not place real secrets in this file.
# This file documents all environment variables used by the project.
# The backend reads from backend/.env and the frontend reads from frontend/.env.
# Copy the appropriate file to .env in each directory and adjust values as needed.

# =============================================================================
# BACKEND SETTINGS (used by backend/app/core/config.py via backend/.env)
# =============================================================================
# APP_NAME=DevFlow API
# APP_ENVIRONMENT=development
# API_V1_PREFIX=/api/v1
# DATABASE_URL=sqlite:///./devflow_local.db
# DATABASE_ECHO=false
# JWT_SECRET_KEY=  # Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# DEMO_ACCESS_TOKEN_EXPIRE_MINUTES=480  # Optional: 8 hours for review environment
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# RATE_LIMIT_LOGIN=5/minute
# RATE_LIMIT_REGISTER=3/minute
# FORWARDED_ALLOW_IPS=  # Trusted proxy IPs for Uvicorn (comma-separated)

# =============================================================================
# FRONTEND SETTINGS (used by frontend via frontend/.env)
# =============================================================================
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# See backend/.env.example and frontend/.env.example for the files actually used.